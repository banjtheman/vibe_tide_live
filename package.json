{
  "name": "vibe-tide-live",
  "private": true,
  "version": "0.1.0",
  "description": "An agent-native 2D platformer workbench built with WebMCP and Phaser.",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
